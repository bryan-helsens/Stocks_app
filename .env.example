# =============================================================================
# DivTrack — environment configuration template.
# Copy to `.env` and adjust. NEVER commit your real .env (it is git-ignored).
# =============================================================================

# ----- General ---------------------------------------------------------------
APP_NAME=DivTrack
ENV=development               # development | staging | production | test
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ----- Security (CHANGE THESE IN PRODUCTION) ---------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# ----- Database --------------------------------------------------------------
# In Docker Compose the host is the service name `postgres`.
DATABASE_URL=postgresql+asyncpg://divtrack:divtrack@postgres:5432/divtrack
POSTGRES_USER=divtrack
POSTGRES_PASSWORD=divtrack
POSTGRES_DB=divtrack
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ----- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----- Money / locale --------------------------------------------------------
BASE_CURRENCY=EUR
DEFAULT_LOCALE=nl-BE

# ----- Market data -----------------------------------------------------------
MARKET_DATA_PROVIDER=yfinance     # yfinance | fmp | alphavantage | eod
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
EOD_API_KEY=
QUOTE_CACHE_TTL_SECONDS=300

# ----- AI providers ----------------------------------------------------------
AI_PROVIDER=ollama                # ollama (local, private) | openai | claude
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
AI_REQUEST_TIMEOUT_SECONDS=60

# ----- Notifications (email + push only; Telegram intentionally unsupported) -
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DivTrack <noreply@divtrack.local>

# ----- Storage ---------------------------------------------------------------
STORAGE_BACKEND=local             # local | s3
STORAGE_LOCAL_PATH=/data/divtrack
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=divtrack
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MAX_UPLOAD_MB=25

# ----- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
